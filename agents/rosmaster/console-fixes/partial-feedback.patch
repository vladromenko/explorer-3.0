     def measured_arm(self, max_age=1.0):
         fb = getattr(self, "_arm_fb", None)
         return fb[0] if fb and time.monotonic() - fb[1] < max_age else None
+
+    def _on_servo_feedback(self, msg):
+        if len(msg.position) == 6:
+            self._servo_fb = (list(msg.position), time.monotonic())
+
+    def feedback_state(self, max_age=.25):
+        fb = getattr(self, "_servo_fb", None)
+        age = None if fb is None else time.monotonic()-fb[1]
+        if age is not None and age < max_age:
+            values = [float(v) if math.isfinite(v) else None for v in fb[0]]
+            return {"positions": values, "valid": [v is not None for v in values], "age": age}
+        full = self.measured_arm(max_age=max_age)
+        return {"positions": full or [None]*6, "valid": [full is not None]*6, "age": age}
+
+    def control_seed(self, max_age=.25):
+        """First five are measured; an unmeasured gripper keeps its last command.
+
+        This is an explicit control seed, never exposed as measured feedback.
+        Gripper commands remain inside the existing manual open/close bounds.
+        """
+        from .arm_model import SERVO_LIMITS
+        state = self.feedback_state(max_age)
+        if not all(state["valid"][:5]):
+            return None
+        pose = list(state["positions"])
+        if any(not lo-1. <= v <= hi+1. for v,(lo,hi) in zip(pose[:5],SERVO_LIMITS[:5])):
+            return None
+        pose[:5] = [min(max(v,lo),hi) for v,(lo,hi) in zip(pose[:5],SERVO_LIMITS[:5])]
+        if pose[5] is None:
+            pose[5] = self._gripper_command
+        if pose[5] is None:
+            return None
+        return pose
+
+    def last_gripper_command(self):
+        return self._gripper_command
 
