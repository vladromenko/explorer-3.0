[Unit]
Description=Explorer 3.0 ROSMASTER agent (inert startup, explicit ownership)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/explorer3
ExecStart=/bin/bash %h/explorer3/start-agent.sh
ExecStopPost=/usr/bin/python3 %h/explorer3/handoff.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=10

[Install]
WantedBy=default.target
